{
  // Configuração do Worker. IDs de KV/D1 são preenchidos pelo setup (ver README).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "edge-traffic-shield",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },

  "vars": {
    // Quanto o hot path espera pelo Durable Object. Estourou => decide com a última
    // velocity conhecida do IP (dica tardia) e o DO termina em background (waitUntil).
    // Medido: DO a ~125 ms de GRU (não há DO na América do Sul), por isso 5 ms.
    "DO_TIMEOUT_MS": "5",
    // Recursos de dev/teste: X-Shield-Chaos (injeção de falha) e X-Shield-Host (simular hostname).
    // Em produção fica "false".
    "DEV_FEATURES": "false",
    // Hostname da plataforma (API de gestão). Vazio = API respondida em qualquer host em /__ets/api.
    // Preenchido: nos domínios dos clientes o caminho /__ets/api não existe (404).
    "PLATFORM_HOST": "edge-traffic-shield.edge-traffic-shield.workers.dev",
    // Hostname de fallback origin da zona SaaS (alvo do CNAME dos clientes).
    "FALLBACK_ORIGIN": "shield.felipetadeu.fyi"
  },

  // Zona SaaS (Cloudflare for SaaS): todo tráfego que entra na zona, inclusive o dos
  // Custom Hostnames dos clientes, cai neste Worker. O fallback origin é um registro
  // AAAA 100:: proxied (sem origem); quem responde é o Worker.
  "routes": [{ "pattern": "*/*", "zone_name": "felipetadeu.fyi" }],
  // Com "routes" declarado o wrangler desliga o workers.dev por padrão; a API de gestão mora nele.
  "workers_dev": true,

  "kv_namespaces": [
    { "binding": "CONFIG_KV", "id": "3921ae31ea314c5c9d6226e228c2cf43" }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ets-db",
      "database_id": "0dae5374-2a4b-4893-87d3-94d7daad5ddb",
      "migrations_dir": "migrations"
    }
  ],

  "durable_objects": {
    "bindings": [
      { "name": "SHIELD_SHARD", "class_name": "ShieldShard" },
      { "name": "TENANT_CONFIG", "class_name": "TenantConfig" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ShieldShard", "TenantConfig"] }
  ],

  "queues": {
    "producers": [{ "binding": "EVENTS_QUEUE", "queue": "ets-events" }],
    "consumers": [
      {
        "queue": "ets-events",
        // Cada mensagem já é um lote de eventos; 10 mensagens por invocação do consumer.
        "max_batch_size": 10,
        "max_batch_timeout": 10,
        "max_retries": 3
      }
    ]
  }
}
